{
  "all": true,
  "src": ["out"],
  "include": [
    "out/analyze/**/*.js",
    "out/privacy/**/*.js",
    "out/output/templates.js",
    "out/core/models.js"
  ],
  "exclude": ["out/test/**"],
  "reporter": ["text-summary", "lcov"],
  "report-dir": "coverage",
  "check-coverage": true,
  "lines": 90,
  "statements": 90,
  "functions": 90,
  "branches": 80
}
