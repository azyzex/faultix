# Source and build tooling: only out/ ships.
#
# out/mcp and out/tools are deliberately included: the MCP server and the
# faultix-brief CLI are user-facing features, and the "Copy MCP Server Config"
# command points at the installed copy of the server.
src/**
out/**/*.map
out/test/**
.vscode/**
.vscode-test/**
.github/**
node_modules/**

# Config
tsconfig.json
eslint.config.js
.eslintrc*
.gitattributes
.gitignore
.editorconfig
package-lock.json

# Docs that do not belong in the package
CONTRIBUTING.md
SECURITY.md
docs/**
*.vsix
coverage/**
.ai-repair/**
